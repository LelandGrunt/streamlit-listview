{
  "name": "streamlit-listview-frontend",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Leland Grunt <33732585+LelandGrunt@users.noreply.github.com>",
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run typecheck && npm run build:frontend:production",
    "build:frontend:production": "cross-env NODE_ENV=production vite build",
    "clean": "rimraf build",
    "dev": "cross-env NODE_ENV=development vite build --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" vite.config.ts vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" vite.config.ts vitest.config.ts",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run typecheck && npm run test:types",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --coverage && npm run test:types",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "prettier": {
    "endOfLine": "auto"
  },
  "dependencies": {
    "@streamlit/component-v2-lib": "^0.2.0",
    "mdast-util-find-and-replace": "^3.0.5",
    "node-emoji": "2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-directive": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "4.13.0",
    "cross-env": "^10.1.0",
    "jsdom": "^31.0.1",
    "mdast-util-directive": "^3.2.1",
    "mdast-util-to-hast": "^13.2.2",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
