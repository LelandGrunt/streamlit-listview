{
  "name": "streamlit-listview-frontend",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Leland Grunt <33732585+LelandGrunt@users.noreply.github.com>",
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run typecheck && npm run build:frontend:production",
    "build:frontend:production": "cross-env NODE_ENV=production vite build",
    "clean": "rimraf build",
    "dev": "cross-env NODE_ENV=development vite build --watch",
    "format": "prettier --write src/**/*.{ts,tsx} vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --coverage && npm run test:types",
    "coverage": "vitest run --coverage"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "prettier": {},
  "dependencies": {
    "@streamlit/component-v2-lib": "^0.2.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "node-emoji": "2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-directive": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.0",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.10"
  }
}
